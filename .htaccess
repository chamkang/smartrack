# ── Smartrack Africa — performance & security ────────────────────────────────
# Applies on Apache hosts (XAMPP, cPanel/shared hosting). Vercel ignores this.

# ── Gzip / Deflate compression ───────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
</IfModule>

# ── Browser caching ──────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType video/mp4               "access plus 1 year"
  ExpiresByType text/css                "access plus 1 month"
  ExpiresByType application/javascript  "access plus 1 month"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived cache for static assets
  <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|mp4|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  # Never cache HTML (content changes via the admin panel)
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Basic security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Protect sensitive files ──────────────────────────────────────────────────
<FilesMatch "\.(db|db-wal|db-shm|sql|log)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(config|setup)\.php$">
  # setup.php should be removed or locked down in production
</FilesMatch>

# Block directory listing
Options -Indexes

# ── Pretty URL for the dynamic sitemap ───────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>
