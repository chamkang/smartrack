# SECURITY: uploads are user-supplied data — never execute code from here.
# This is defence-in-depth; upload_* functions also force safe extensions.

php_flag engine off

<IfModule mod_php.c>
  php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_admin_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_admin_flag engine off
</IfModule>

# Block any script-like file from being served/run
<FilesMatch "\.(php|php\d|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|htaccess)$">
  Require all denied
</FilesMatch>

# Force downloads rather than inline rendering (prevents stored-XSS via SVG/HTML)
<FilesMatch "\.(svg|html?|xml)$">
  Header set Content-Disposition "attachment"
  Header set Content-Security-Policy "default-src 'none'; sandbox"
</FilesMatch>

Options -Indexes -ExecCGI
AddType text/plain .php .phtml .phar .pl .py .cgi .sh
